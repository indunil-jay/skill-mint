{
  "name": "@skill-mint/prettier-config",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Prettier configuration for skill-mint monorepo",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@skill-mint/typescript-config": "workspace:*",
    "prettier": "^3.4.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  }
}
